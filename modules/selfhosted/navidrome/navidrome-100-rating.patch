@@ -0,0 +1,18 @@
+-- +goose Up
+
+-- Ratings used to be constrained to 0-5 by the Subsonic spec. This server
+-- now accepts 0-100, so existing data is rescaled onto the new range
+-- (x20) to stay consistent with ratings set going forward.
+UPDATE annotation SET rating = rating * 20 WHERE rating > 0;
+UPDATE album SET average_rating = average_rating * 20 WHERE average_rating > 0;
+UPDATE media_file SET average_rating = average_rating * 20 WHERE average_rating > 0;
+UPDATE artist SET average_rating = average_rating * 20 WHERE average_rating > 0;
+UPDATE playlist SET average_rating = average_rating * 20 WHERE average_rating > 0;
+
+-- +goose Down
+
+UPDATE annotation SET rating = rating / 20 WHERE rating > 0;
+UPDATE album SET average_rating = average_rating / 20 WHERE average_rating > 0;
+UPDATE media_file SET average_rating = average_rating / 20 WHERE average_rating > 0;
+UPDATE artist SET average_rating = average_rating / 20 WHERE average_rating > 0;
+UPDATE playlist SET average_rating = average_rating / 20 WHERE average_rating > 0;
