diff --git a/ui/src/common/RatingField.test.jsx b/ui/src/common/RatingField.test.jsx
new file mode 100644
index 0000000..8628b61
--- /dev/null
+++ b/ui/src/common/RatingField.test.jsx
@@ -0,0 +1,119 @@
+import React from 'react'
+import { render, screen, fireEvent } from '@testing-library/react'
+import { describe, it, expect, beforeEach, vi } from 'vitest'
+import { RecordContextProvider, useDataProvider } from 'react-admin'
+import { RatingField } from './RatingField'
+import subsonic from '../subsonic'
+
+vi.mock('../subsonic', () => ({
+  default: {
+    setRating: vi.fn(() => Promise.resolve()),
+  },
+}))
+
+vi.mock('react-admin', async (importOriginal) => ({
+  ...(await importOriginal()),
+  useDataProvider: vi.fn(),
+  useNotify: vi.fn(() => vi.fn()),
+  useRefresh: vi.fn(() => vi.fn()),
+}))
+
+describe('<RatingField>', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    useDataProvider.mockReturnValue({
+      getOne: vi.fn(() => Promise.resolve({ data: {} })),
+    })
+  })
+
+  const renderField = (record) =>
+    render(
+      <RecordContextProvider value={record}>
+        <RatingField resource="song" source="rating" />
+      </RecordContextProvider>,
+    )
+
+  it('shows the current rating', () => {
+    renderField({ id: 'sg-1', rating: 73 })
+    expect(screen.getByText('73')).toBeInTheDocument()
+  })
+
+  it('shows a placeholder when unrated', () => {
+    renderField({ id: 'sg-1', rating: 0 })
+    expect(screen.getByText('–')).toBeInTheDocument()
+  })
+
+  it('turns into an input on click and commits the new value on Enter', () => {
+    renderField({ id: 'sg-1', rating: 10 })
+
+    fireEvent.click(screen.getByText('10'))
+    const input = screen.getByRole('spinbutton')
+    fireEvent.change(input, { target: { value: '42' } })
+    fireEvent.keyDown(input, { key: 'Enter' })
+
+    expect(subsonic.setRating).toHaveBeenCalledWith('sg-1', 42)
+  })
+
+  it('commits on blur as well as Enter', () => {
+    renderField({ id: 'sg-1', rating: 10 })
+
+    fireEvent.click(screen.getByText('10'))
+    const input = screen.getByRole('spinbutton')
+    fireEvent.change(input, { target: { value: '55' } })
+    fireEvent.blur(input)
+
+    expect(subsonic.setRating).toHaveBeenCalledWith('sg-1', 55)
+  })
+
+  it('clamps values above the maximum', () => {
+    renderField({ id: 'sg-1', rating: 10 })
+
+    fireEvent.click(screen.getByText('10'))
+    const input = screen.getByRole('spinbutton')
+    fireEvent.change(input, { target: { value: '500' } })
+    fireEvent.keyDown(input, { key: 'Enter' })
+
+    expect(subsonic.setRating).toHaveBeenCalledWith('sg-1', 100)
+  })
+
+  it('clamps negative values to zero', () => {
+    renderField({ id: 'sg-1', rating: 10 })
+
+    fireEvent.click(screen.getByText('10'))
+    const input = screen.getByRole('spinbutton')
+    fireEvent.change(input, { target: { value: '-5' } })
+    fireEvent.keyDown(input, { key: 'Enter' })
+
+    expect(subsonic.setRating).toHaveBeenCalledWith('sg-1', 0)
+  })
+
+  it('cancels without committing on Escape', () => {
+    renderField({ id: 'sg-1', rating: 10 })
+
+    fireEvent.click(screen.getByText('10'))
+    const input = screen.getByRole('spinbutton')
+    fireEvent.change(input, { target: { value: '42' } })
+    fireEvent.keyDown(input, { key: 'Escape' })
+
+    expect(subsonic.setRating).not.toHaveBeenCalled()
+    expect(screen.getByText('10')).toBeInTheDocument()
+  })
+
+  it('does not enter edit mode when the record is missing', () => {
+    renderField({ id: 'sg-1', rating: 10, missing: true })
+
+    fireEvent.click(screen.getByText('10'))
+
+    expect(screen.queryByRole('spinbutton')).not.toBeInTheDocument()
+  })
+
+  it('does not call setRating when the committed value is unchanged', () => {
+    renderField({ id: 'sg-1', rating: 10 })
+
+    fireEvent.click(screen.getByText('10'))
+    const input = screen.getByRole('spinbutton')
+    fireEvent.keyDown(input, { key: 'Enter' })
+
+    expect(subsonic.setRating).not.toHaveBeenCalled()
+  })
+})
